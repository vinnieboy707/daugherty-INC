# Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/daugherty-inc

# Frontend URL (for CORS) - can be comma-separated for multiple origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# JWT Secret - MUST be changed in production
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_DO_NOT_USE_THIS_VALUE

# Session Secret
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_DO_NOT_USE_THIS_VALUE

# File Upload
MAX_FILE_SIZE=10485760

# Business Contact Information
BUSINESS_NAME=Nate Daugherty - Tattoo Artist
CONTACT_PHONE=+1-555-0123
CONTACT_EMAIL=contact@example.com
CONTACT_INSTAGRAM=@natedaugherty_tattoos
CONTACT_LOCATION=Mendocino, CA

# Website Information
WEBSITE_URL=https://daugherty-inc.com
WEBSITE_TITLE=Nate Daugherty - Professional Tattoo Artist
WEBSITE_DESCRIPTION=Check out Nate Daugherty, a talented Mendocino tattoo artist! Support local artists and promote individual business growth in our community. Book your consultation today!

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# AI Service (optional - for tattoo preview generation)
OPENAI_API_KEY=your-openai-api-key
