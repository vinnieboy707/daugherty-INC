# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/daugherty-inc
# or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Stripe Payment Configuration (for donations and ACH)
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Admin Access (for ACH management and other admin features)
ADMIN_SECRET_KEY=your-secure-random-admin-key-here

# OpenAI Configuration (for AI assistant features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google OAuth (for social media integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session Secret
SESSION_SECRET=your-session-secret-here

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Configuration (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@daugherty-inc.com

# ACH Payment Notes:
# - Use test keys (sk_test_...) for development
# - Switch to live keys (sk_live_...) for production
# - Enable ACH in Stripe Dashboard: Settings → Payment Methods
# - Configure webhooks: Settings → Webhooks → Add endpoint
# - Required webhook events: charge.succeeded, charge.failed, charge.pending
# - ACH payments take 3-5 business days to complete
