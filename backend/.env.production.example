# Production Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production

# Database - REQUIRED: Update with your production MongoDB connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/daugherty-inc
MONGODB_URI=mongodb://localhost:27017/daugherty-inc

# Frontend URL - REQUIRED: Update with your production frontend URL
FRONTEND_URL=https://yourdomain.com

# Security - REQUIRED: Generate a strong random secret
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# File Upload Configuration
MAX_FILE_SIZE=10485760

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-production-email@gmail.com
EMAIL_PASSWORD=your-secure-app-password

# AI Service Configuration (Optional - for real tattoo preview)
OPENAI_API_KEY=your-production-openai-api-key

# Rate Limiting (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_STRING

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
