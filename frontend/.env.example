# Frontend Environment Variables (Optional)

# API URL - Update for production deployment
VITE_API_URL=http://localhost:5000/api

# Application Settings
VITE_APP_NAME=Daugherty Inc
VITE_APP_VERSION=2.0.0

# Feature Flags (Optional)
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_TATTOO_PREVIEW=true
VITE_ENABLE_VIP_SERVICES=true

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_FACEBOOK_PIXEL_ID=

# Contact Information (will override placeholders)
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_INSTAGRAM=
VITE_CONTACT_LOCATION=
