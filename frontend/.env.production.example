# Production Environment Variables for Frontend

# API URL - REQUIRED: Update with your production API URL
VITE_API_URL=https://api.yourdomain.com/api

# Application Settings
VITE_APP_NAME=Daugherty Inc
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_TATTOO_PREVIEW=true
VITE_ENABLE_VIP_SERVICES=true

# Analytics (Optional - add your tracking IDs)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_FACEBOOK_PIXEL_ID=

# Contact Information - Update with actual contact details
VITE_CONTACT_PHONE=(555) 123-4567
VITE_CONTACT_EMAIL=nate@daugherty-inc.com
VITE_CONTACT_INSTAGRAM=@natedaugherty_ink
VITE_CONTACT_LOCATION=Los Angeles, CA
